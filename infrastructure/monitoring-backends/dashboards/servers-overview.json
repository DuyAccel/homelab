    {
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_ds}"
      },
      "description": "Kepler CPU package power from the node hardware meter. This is CPU-package power, not total chassis power.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 } ] },
          "unit": "watt"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "id": 5,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "hideZeros": false, "mode": "single", "sort": "none" }
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "max by (node_name) (kepler_node_cpu_watts{cluster=\"homelab\", zone=\"package\"})",
          "legendFormat": "{{node_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Kepler: Node CPU package power (W)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_ds}"
      },
      "description": "Kepler attributes host CPU package power to Pods using CPU activity. This is an estimate, not a per-Pod hardware meter.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 } ] },
          "unit": "watt"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "id": 6,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "hideZeros": false, "mode": "single", "sort": "none" }
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "topk(10, sum by (pod_namespace, pod_name, node_name) (kepler_pod_cpu_watts{cluster=\"homelab\", zone=\"package\"}))",
          "legendFormat": "{{pod_namespace}}/{{pod_name}} @ {{node_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Kepler: Top Pods by attributed CPU power (W)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_ds}"
      },
      "description": "Increase of the node CPU package energy counter over the last 24 hours, converted from joules to kWh.",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 } ] },
          "unit": "kwatth"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "id": 7,
      "options": { "cellHeight": "sm", "showHeader": true },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (node_name) (increase(kepler_node_cpu_joules_total{cluster=\"homelab\", zone=\"package\"}[24h])) / 3600000",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Kepler: Node CPU package energy (kWh / 24h)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "node_name": 0, "Value": 1 },
            "renameByName": { "node_name": "Node", "Value": "CPU package energy (kWh)" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_ds}"
      },
      "description": "Kepler-attributed Pod CPU package energy over the last 24 hours. Attribution is model-based and should be treated as a trend signal, not financial-grade allocation.",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 } ] },
          "unit": "kwatth"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "id": 8,
      "options": { "cellHeight": "sm", "showHeader": true, "sortBy": [ { "desc": true, "displayName": "CPU energy (kWh)" } ] },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "topk(10, sum by (pod_namespace, pod_name, node_name) (increase(kepler_pod_cpu_joules_total{cluster=\"homelab\", zone=\"package\"}[24h])) / 3600000)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Kepler: Top Pods by attributed CPU energy (kWh / 24h)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "pod_namespace": 0, "pod_name": 1, "node_name": 2, "Value": 3 },
            "renameByName": { "pod_namespace": "Namespace", "pod_name": "Pod", "node_name": "Node", "Value": "CPU energy (kWh)" }
          }
        }
      ],
      "type": "table"
    }
