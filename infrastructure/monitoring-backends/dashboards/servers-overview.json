          "exemplar": false,
          "expr": "(100 -\r\n    (\r\n    avg by (instance) (node_memory_MemAvailable_bytes{job=\"integrations/node_exporter\"}) / \r\n    avg by (instance) (node_memory_MemTotal_bytes{job=\"integrations/node_exporter\"}) * 100\r\n    )\r\n)",
